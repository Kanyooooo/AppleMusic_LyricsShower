<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="MemoryTokenProbe.cs" />
    <Compile Include="MemoryStringSearcher.cs" />
    <Compile Include="..\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\Services\AppleMusicProcessFinder.cs" Link="Services\AppleMusicProcessFinder.cs" />
    <Compile Include="..\Services\LyricsMatcher.cs" Link="Services\LyricsMatcher.cs" />
    <Compile Include="..\Services\MediaSessionService.cs" Link="Services\MediaSessionService.cs" />
    <Compile Include="..\Services\ProcessMemoryTtmlExtractor.cs" Link="Services\ProcessMemoryTtmlExtractor.cs" />
    <Compile Include="..\Services\TtmlLyricsParser.cs" Link="Services\TtmlLyricsParser.cs" />
    <Compile Include="..\Services\AppleMusicLyricAnchorService.cs" Link="Services\AppleMusicLyricAnchorService.cs" />
    <Compile Include="..\Services\LrcLibLyricsService.cs" Link="Services\LrcLibLyricsService.cs" />
  </ItemGroup>

</Project>
