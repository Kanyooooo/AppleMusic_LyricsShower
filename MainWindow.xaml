<Window x:Class="AppleMusicTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple Music Translator"
        Width="980"
        Height="360"
        MinWidth="520"
        MinHeight="180"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="ContextSettingsMenuItem" Header="Settings" Click="SettingsMenuItem_Click" />
            <MenuItem x:Name="ContextOpenDataDirectoryMenuItem" Header="Open data directory" Click="OpenDataDirectoryMenuItem_Click" />
            <MenuItem x:Name="ContextTranslationMenuItem" Header="Toggle translation" Click="ToggleTranslationMenuItem_Click" />
            <MenuItem x:Name="ContextLyricsOnlyMenuItem" Header="Lyrics-only mode" Click="LyricsOnlyMenuItem_Click" />
            <Separator />
            <MenuItem x:Name="ContextExitMenuItem" Header="Exit" Click="CloseMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2532383D" />
            <Setter Property="BorderBrush" Value="#3EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#405DFFE6" />
                    <Setter Property="BorderBrush" Value="#8FFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SwatchStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Content" Value="" />
        </Style>

        <CubicEase x:Key="SoftEaseOut" EasingMode="EaseOut" />
    </Window.Resources>

    <Border x:Name="Shell"
            Margin="12"
            Padding="18"
            Background="#D9181B22"
            BorderBrush="#665DFFE6"
            BorderThickness="1"
            CornerRadius="8"
            RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScaleTransform" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="TrackText"
                               Foreground="#F2FFFFFF"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Waiting for Apple Music"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,4,0,0"
                               Foreground="#AFC8D3D8"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12"
                               Text="Play a song in Apple Music" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Grid Margin="0,0,8,0">
                        <Button x:Name="WrongLyricsButton"
                                Width="36"
                                Height="30"
                                Click="WrongLyricsButton_Click"
                                Content="!"
                                Style="{StaticResource ToolButtonStyle}"
                                ToolTip="不是这首歌" />
                        <Border x:Name="LyricsConflictBadge"
                                Width="10"
                                Height="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#FFFF4D6D"
                                CornerRadius="5"
                                Visibility="Collapsed">
                            <TextBlock Text="!"
                                       Foreground="#FFFFFFFF"
                                       FontFamily="Segoe UI"
                                       FontSize="7"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <Button x:Name="RefreshButton"
                            Width="36"
                            Height="30"
                            Margin="0,0,8,0"
                            Click="RefreshButton_Click"
                            Content="R"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Rescan lyrics" />
                    <Button x:Name="MinimizeButton"
                            Width="36"
                            Height="30"
                            Margin="0,0,8,0"
                            Click="MinimizeButton_Click"
                            Content="_"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Minimize" />
                    <Button x:Name="CloseButton"
                            Width="36"
                            Height="30"
                            Click="CloseButton_Click"
                            Content="×"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Hide window" />
                </StackPanel>
            </Grid>

            <Grid x:Name="LyricGrid"
                  Grid.Row="1"
                  Margin="0,18,0,12"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="LyricContentTransform" />
                </Grid.RenderTransform>

                <Grid x:Name="CenterLyricsView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="OriginalText"
                               Foreground="#D5FFFFFF"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="18"
                               Text=""
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MainLyricText"
                               Grid.Row="1"
                               Margin="0,8,0,0"
                               Foreground="#FFFFFFFF"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="30"
                               FontWeight="Bold"
                               LineHeight="38"
                               Text="Lyrics are standing by"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>

                <ScrollViewer x:Name="VerticalLyricsView"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="VerticalLyricsPanel" />
                </ScrollViewer>
            </Grid>

            <Grid x:Name="FooterGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="SongProgress"
                             Height="4"
                             Maximum="1"
                             Value="0"
                             VerticalAlignment="Center" />
                <TextBlock x:Name="SourceText"
                           Grid.Column="1"
                           Margin="14,0,12,0"
                           Foreground="#8FAEBBC1"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Text="Apple Music memory" />
                <Button x:Name="SettingsButton"
                        Grid.Column="2"
                        Width="72"
                        Height="30"
                        Click="SettingsButton_Click"
                        Content="Settings"
                        Style="{StaticResource ToolButtonStyle}" />
            </Grid>

            <Button x:Name="CornerSettingsButton"
                    Grid.RowSpan="3"
                    Width="32"
                    Height="32"
                    Margin="0,0,4,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="SettingsButton_Click"
                    Content="⚙"
                    FontFamily="Segoe UI Symbol"
                    FontSize="15"
                    ContextMenuOpening="CornerSettingsButton_ContextMenuOpening"
                    Style="{StaticResource ToolButtonStyle}"
                    ToolTip="Settings"
                    Visibility="Collapsed">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CornerSettingsMenuItem" Header="Settings" Click="SettingsMenuItem_Click" />
                        <MenuItem x:Name="CornerRescanMenuItem" Header="Rescan lyrics" Click="CornerRescanMenuItem_Click" />
                        <MenuItem x:Name="CornerTranslationMenuItem" Header="Toggle translation" Click="ToggleTranslationMenuItem_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>
    </Border>
</Window>

