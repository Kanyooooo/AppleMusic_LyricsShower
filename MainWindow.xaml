<Window x:Class="AppleMusicTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple Music Translator"
        Width="980"
        Height="360"
        MinWidth="520"
        MinHeight="180"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="ContextSettingsMenuItem" Header="Settings" Click="SettingsMenuItem_Click" />
            <MenuItem x:Name="ContextTranslationMenuItem" Header="Toggle translation" Click="ToggleTranslationMenuItem_Click" />
            <MenuItem x:Name="ContextLyricsOnlyMenuItem" Header="Lyrics-only mode" Click="LyricsOnlyMenuItem_Click" />
            <Separator />
            <MenuItem x:Name="ContextExitMenuItem" Header="Exit" Click="CloseMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2532383D" />
            <Setter Property="BorderBrush" Value="#3EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#405DFFE6" />
                    <Setter Property="BorderBrush" Value="#8FFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SwatchStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Content" Value="" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell"
            Margin="12"
            Padding="18"
            Background="#D9181B22"
            BorderBrush="#665DFFE6"
            BorderThickness="1"
            CornerRadius="8"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="TrackText"
                               Foreground="#F2FFFFFF"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Waiting for Apple Music"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,4,0,0"
                               Foreground="#AFC8D3D8"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12"
                               Text="Play a song in Apple Music" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Grid Margin="0,0,8,0">
                        <Button x:Name="WrongLyricsButton"
                                Width="36"
                                Height="30"
                                Click="WrongLyricsButton_Click"
                                Content="!"
                                Style="{StaticResource ToolButtonStyle}"
                                ToolTip="不是这首歌" />
                        <Border x:Name="LyricsConflictBadge"
                                Width="10"
                                Height="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#FFFF4D6D"
                                CornerRadius="5"
                                Visibility="Collapsed">
                            <TextBlock Text="!"
                                       Foreground="#FFFFFFFF"
                                       FontFamily="Segoe UI"
                                       FontSize="7"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <Button x:Name="RefreshButton"
                            Width="36"
                            Height="30"
                            Margin="0,0,8,0"
                            Click="RefreshButton_Click"
                            Content="↻"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Rescan lyrics" />
                    <Button x:Name="MinimizeButton"
                            Width="36"
                            Height="30"
                            Margin="0,0,8,0"
                            Click="MinimizeButton_Click"
                            Content="—"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Minimize" />
                    <Button x:Name="CloseButton"
                            Width="36"
                            Height="30"
                            Click="CloseButton_Click"
                            Content="×"
                            Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Hide window" />
                </StackPanel>
            </Grid>

            <Grid x:Name="LyricGrid"
                  Grid.Row="1"
                  Margin="0,18,0,12"
                  MouseLeftButtonDown="LyricGrid_MouseLeftButtonDown"
                  MouseLeftButtonUp="LyricGrid_MouseLeftButtonUp"
                  MouseMove="LyricGrid_MouseMove">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="LyricContentTransform" />
                </Grid.RenderTransform>

                <Grid x:Name="CenterLyricsView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="OriginalText"
                               Foreground="#D5FFFFFF"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="18"
                               Text=""
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MainLyricText"
                               Grid.Row="1"
                               Margin="0,8,0,0"
                               Foreground="#FFFFFFFF"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="30"
                               FontWeight="Bold"
                               LineHeight="38"
                               Text="Lyrics are standing by"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="IslandLyricsView"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IslandAccentBar"
                            Width="4"
                            Margin="0,8,12,8"
                            Background="#FF5DFFE6"
                            CornerRadius="2" />
                    <Grid Grid.Column="1"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="IslandOriginalText"
                                   Foreground="#D5FFFFFF"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="13"
                                   Text=""
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="IslandMainLyricText"
                                   Grid.Row="1"
                                   Margin="0,3,0,0"
                                   Foreground="#FFFFFFFF"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Text="Lyrics are standing by"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="VerticalLyricsView"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="VerticalLyricsPanel" />
                </ScrollViewer>
            </Grid>

            <Grid x:Name="FooterGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="SongProgress"
                             Height="4"
                             Maximum="1"
                             Value="0"
                             VerticalAlignment="Center" />
                <TextBlock x:Name="SourceText"
                           Grid.Column="1"
                           Margin="14,0,12,0"
                           Foreground="#8FAEBBC1"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Text="Apple Music memory" />
                <Button x:Name="SettingsButton"
                        Grid.Column="2"
                        Width="72"
                        Height="30"
                        Click="SettingsButton_Click"
                        Content="Settings"
                        Style="{StaticResource ToolButtonStyle}" />
            </Grid>

            <Border x:Name="SettingsPanel"
                    Grid.RowSpan="3"
                    Width="360"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#F01B2028"
                    BorderBrush="#665DFFE6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="SettingsPanelTitle"
                                       Foreground="#FFFFFFFF"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Display settings" />
                            <Button HorizontalAlignment="Right"
                                    Width="28"
                                    Height="24"
                                    Click="CloseSettingsButton_Click"
                                    Content="×"
                                    Style="{StaticResource ToolButtonStyle}" />
                        </Grid>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="InterfaceLanguageLabel" Foreground="#BFC8D3D8" Text="Interface language" />
                            <ComboBox x:Name="InterfaceLanguageComboBox"
                                      SelectionChanged="InterfaceLanguageComboBox_SelectionChanged"
                                      Background="#33181B22"
                                      Foreground="#FFFFFFFF">
                                <ComboBoxItem Content="简体中文" Tag="ChineseSimplified" />
                                <ComboBoxItem Content="English" Tag="English" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="ShowTranslationCheckBox"
                                  Margin="0,0,0,10"
                                  Checked="ShowTranslationCheckBox_Changed"
                                  Unchecked="ShowTranslationCheckBox_Changed"
                                  Foreground="#FFFFFFFF"
                                  Content="Show translation" />
                        <CheckBox x:Name="LyricsOnlyCheckBox"
                                  Margin="0,0,0,14"
                                  Checked="LyricsOnlyCheckBox_Changed"
                                  Unchecked="LyricsOnlyCheckBox_Changed"
                                  Foreground="#FFFFFFFF"
                                  Content="Lyrics-only window" />
                        <CheckBox x:Name="VerticalLyricsCheckBox"
                                  Margin="0,0,0,10"
                                  Checked="VerticalLyricsCheckBox_Changed"
                                  Unchecked="VerticalLyricsCheckBox_Changed"
                                  Foreground="#FFFFFFFF"
                                  Content="Vertical lyrics" />
                        <CheckBox x:Name="IslandModeCheckBox"
                                  Margin="0,0,0,10"
                                  Checked="IslandModeCheckBox_Changed"
                                  Unchecked="IslandModeCheckBox_Changed"
                                  Foreground="#FFFFFFFF"
                                  Content="Dynamic island" />
                        <CheckBox x:Name="AutoScrollLongLyricsCheckBox"
                                  Margin="0,0,0,10"
                                  Checked="AutoScrollLongLyricsCheckBox_Changed"
                                  Unchecked="AutoScrollLongLyricsCheckBox_Changed"
                                  Foreground="#FFFFFFFF"
                                  Content="Auto scroll long lyrics" />
                        <CheckBox x:Name="AutoCenterCurrentLyricCheckBox"
                                  Margin="0,0,0,10"
                                  Checked="AutoCenterCurrentLyricCheckBox_Changed"
                                  Unchecked="AutoCenterCurrentLyricCheckBox_Changed"
                                  Foreground="#FFFFFFFF"
                                  Content="Center current lyric" />
                        <CheckBox x:Name="AutoLyricsPanelCheckBox"
                                  Margin="0,0,0,10"
                                  Checked="AutoLyricsPanelCheckBox_Changed"
                                  Unchecked="AutoLyricsPanelCheckBox_Changed"
                                  Foreground="#FFFFFFFF"
                                  Content="Auto open Apple Music lyrics" />
                        <CheckBox x:Name="AutoContrastCheckBox"
                                  Margin="0,0,0,14"
                                  Checked="AutoContrastCheckBox_Changed"
                                  Unchecked="AutoContrastCheckBox_Changed"
                                  Foreground="#FFFFFFFF"
                                  Content="Auto contrast text" />

                        <TextBlock x:Name="LyricOffsetLabel" Foreground="#BFC8D3D8" Text="Lyric lead" />
                        <Slider x:Name="LyricOffsetSlider"
                                Minimum="0"
                                Maximum="2200"
                                TickFrequency="10"
                                IsSnapToTickEnabled="False"
                                ValueChanged="LyricOffsetSlider_ValueChanged" />
                        <TextBlock x:Name="LyricOffsetHintText"
                                   Margin="0,4,0,0"
                                   Foreground="#8FAEBBC1"
                                   FontSize="11"
                                   Text="Higher values show lines earlier." />

                        <TextBlock x:Name="MainFontLabel" Margin="0,10,0,0" Foreground="#BFC8D3D8" Text="Main text size" />
                        <Slider x:Name="MainFontSlider"
                                Minimum="20"
                                Maximum="56"
                                ValueChanged="MainFontSlider_ValueChanged" />

                        <TextBlock x:Name="OriginalFontLabel" Margin="0,10,0,0" Foreground="#BFC8D3D8" Text="Original text size" />
                        <Slider x:Name="OriginalFontSlider"
                                Minimum="12"
                                Maximum="32"
                                ValueChanged="OriginalFontSlider_ValueChanged" />

                        <TextBlock x:Name="BackgroundOpacityLabel" Margin="0,10,0,0" Foreground="#BFC8D3D8" Text="Background opacity" />
                        <Slider x:Name="BackgroundOpacitySlider"
                                Minimum="0"
                                Maximum="100"
                                ValueChanged="BackgroundOpacitySlider_ValueChanged" />

                        <TextBlock x:Name="LyricPositionXLabel" Margin="0,10,0,0" Foreground="#BFC8D3D8" Text="Lyric X" />
                        <Slider x:Name="LyricPositionXSlider"
                                Minimum="-360"
                                Maximum="360"
                                TickFrequency="1"
                                ValueChanged="LyricPositionXSlider_ValueChanged" />

                        <TextBlock x:Name="LyricPositionYLabel" Margin="0,10,0,0" Foreground="#BFC8D3D8" Text="Lyric Y" />
                        <Slider x:Name="LyricPositionYSlider"
                                Minimum="-180"
                                Maximum="180"
                                TickFrequency="1"
                                ValueChanged="LyricPositionYSlider_ValueChanged" />

                        <TextBlock x:Name="IslandWidthLabel" Margin="0,10,0,0" Foreground="#BFC8D3D8" Text="Island width" />
                        <Slider x:Name="IslandWidthSlider"
                                Minimum="360"
                                Maximum="1200"
                                TickFrequency="10"
                                ValueChanged="IslandWidthSlider_ValueChanged" />

                        <TextBlock x:Name="IslandHeightLabel" Margin="0,10,0,0" Foreground="#BFC8D3D8" Text="Island height" />
                        <Slider x:Name="IslandHeightSlider"
                                Minimum="68"
                                Maximum="180"
                                TickFrequency="2"
                                ValueChanged="IslandHeightSlider_ValueChanged" />

                        <TextBlock x:Name="IslandTopOffsetLabel" Margin="0,10,0,0" Foreground="#BFC8D3D8" Text="Island top offset" />
                        <Slider x:Name="IslandTopOffsetSlider"
                                Minimum="0"
                                Maximum="120"
                                TickFrequency="1"
                                ValueChanged="IslandTopOffsetSlider_ValueChanged" />

                        <TextBlock x:Name="MainColorLabel" Margin="0,12,0,6" Foreground="#BFC8D3D8" Text="Main color" />
                        <StackPanel Orientation="Horizontal">
                            <Button Tag="#FFFFFFFF" Background="#FFFFFFFF" Click="MainColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#FF5DFFE6" Background="#FF5DFFE6" Click="MainColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#FFFFE082" Background="#FFFFE082" Click="MainColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#FFFF8FB3" Background="#FFFF8FB3" Click="MainColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#FFB8FF8B" Background="#FFB8FF8B" Click="MainColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Width="58" Height="24" Click="CustomMainColorButton_Click" Content="Custom" Style="{StaticResource ToolButtonStyle}" />
                        </StackPanel>

                        <TextBlock x:Name="OriginalColorLabel" Margin="0,12,0,6" Foreground="#BFC8D3D8" Text="Original color" />
                        <StackPanel Orientation="Horizontal">
                            <Button Tag="#D5FFFFFF" Background="#D5FFFFFF" Click="OriginalColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#FFB6C7D8" Background="#FFB6C7D8" Click="OriginalColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#FFFFE082" Background="#FFFFE082" Click="OriginalColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#FFB8FF8B" Background="#FFB8FF8B" Click="OriginalColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Width="58" Height="24" Click="CustomOriginalColorButton_Click" Content="Custom" Style="{StaticResource ToolButtonStyle}" />
                        </StackPanel>

                        <TextBlock x:Name="BackgroundColorLabel" Margin="0,12,0,6" Foreground="#BFC8D3D8" Text="Background color" />
                        <StackPanel Orientation="Horizontal">
                            <Button Tag="#181B22" Background="#FF181B22" Click="BackgroundColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#F7F7F2" Background="#FFF7F7F2" Click="BackgroundColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#101418" Background="#FF101418" Click="BackgroundColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#1F2732" Background="#FF1F2732" Click="BackgroundColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#FFF4E8" Background="#FFFFF4E8" Click="BackgroundColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Width="58" Height="24" Click="CustomBackgroundColorButton_Click" Content="Custom" Style="{StaticResource ToolButtonStyle}" />
                        </StackPanel>

                        <TextBlock x:Name="AccentColorLabel" Margin="0,12,0,6" Foreground="#BFC8D3D8" Text="Accent color" />
                        <StackPanel Orientation="Horizontal">
                            <Button Tag="#5DFFE6" Background="#FF5DFFE6" Click="AccentColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#FF4D6D" Background="#FFFF4D6D" Click="AccentColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#8BC7FF" Background="#FF8BC7FF" Click="AccentColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Tag="#FFD166" Background="#FFFFD166" Click="AccentColorButton_Click" Style="{StaticResource SwatchStyle}" />
                            <Button Width="58" Height="24" Click="CustomAccentColorButton_Click" Content="Custom" Style="{StaticResource ToolButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
