<Window x:Class="AppleMusicTranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420"
        Height="680"
        MinWidth="380"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FF141820"
        Topmost="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2532383D" />
            <Setter Property="BorderBrush" Value="#3EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#405DFFE6" />
                    <Setter Property="BorderBrush" Value="#8FFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SwatchStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Content" Value="" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#BFC8D3D8" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Border Padding="18"
            Background="#FF141820"
            BorderBrush="#334D6472"
            BorderThickness="1">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock x:Name="SettingsPanelTitle"
                           Foreground="#FFFFFFFF"
                           FontSize="17"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Text="Display settings" />
                <Button x:Name="CloseSettingsButton"
                        Width="32"
                        Height="28"
                        HorizontalAlignment="Right"
                        Click="CloseSettingsButton_Click"
                        Content="X"
                        Style="{StaticResource ToolButtonStyle}" />
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock x:Name="InterfaceLanguageLabel" Text="Interface language" />
                        <ComboBox x:Name="InterfaceLanguageComboBox"
                                  Margin="0,6,0,0"
                                  SelectionChanged="InterfaceLanguageComboBox_SelectionChanged"
                                  Background="#33181B22"
                                  Foreground="#FFFFFFFF">
                            <ComboBoxItem Content="简体中文" Tag="ChineseSimplified" />
                            <ComboBoxItem Content="English" Tag="English" />
                        </ComboBox>
                    </StackPanel>

                    <CheckBox x:Name="ShowTranslationCheckBox"
                              Checked="ShowTranslationCheckBox_Changed"
                              Unchecked="ShowTranslationCheckBox_Changed"
                              Content="Show translation" />
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock x:Name="WindowModeLabel" Text="Window mode" />
                        <ComboBox x:Name="WindowModeComboBox"
                                  Margin="0,6,0,0"
                                  SelectionChanged="WindowModeComboBox_SelectionChanged"
                                  Background="#33181B22"
                                  Foreground="#FFFFFFFF">
                            <ComboBoxItem Content="Normal window" Tag="Normal" />
                            <ComboBoxItem Content="Lyrics-only window" Tag="LyricsOnly" />
                            <ComboBoxItem Content="Dynamic island" Tag="Island" />
                        </ComboBox>
                    </StackPanel>

                    <CheckBox x:Name="LyricsOnlyCheckBox"
                              Visibility="Collapsed"
                              Checked="LyricsOnlyCheckBox_Changed"
                              Unchecked="LyricsOnlyCheckBox_Changed"
                              Content="Lyrics-only window" />
                    <CheckBox x:Name="VerticalLyricsCheckBox"
                              Checked="VerticalLyricsCheckBox_Changed"
                              Unchecked="VerticalLyricsCheckBox_Changed"
                              Content="Vertical lyrics" />
                    <CheckBox x:Name="IslandModeCheckBox"
                              Visibility="Collapsed"
                              Checked="IslandModeCheckBox_Changed"
                              Unchecked="IslandModeCheckBox_Changed"
                              Content="Dynamic island" />
                    <CheckBox x:Name="AutoScrollLongLyricsCheckBox"
                              Checked="AutoScrollLongLyricsCheckBox_Changed"
                              Unchecked="AutoScrollLongLyricsCheckBox_Changed"
                              Content="Auto scroll long lyrics" />
                    <CheckBox x:Name="AutoCenterCurrentLyricCheckBox"
                              Checked="AutoCenterCurrentLyricCheckBox_Changed"
                              Unchecked="AutoCenterCurrentLyricCheckBox_Changed"
                              Content="Center current lyric" />
                    <CheckBox x:Name="AutoLyricsPanelCheckBox"
                              Checked="AutoLyricsPanelCheckBox_Changed"
                              Unchecked="AutoLyricsPanelCheckBox_Changed"
                              Content="Auto open Apple Music lyrics" />
                    <CheckBox x:Name="AutoContrastCheckBox"
                              Checked="AutoContrastCheckBox_Changed"
                              Unchecked="AutoContrastCheckBox_Changed"
                              Content="Auto contrast text" />

                    <TextBlock x:Name="LyricOffsetLabel" Margin="0,4,0,0" Text="Lyric lead" />
                    <Slider x:Name="LyricOffsetSlider"
                            Minimum="0"
                            Maximum="2200"
                            TickFrequency="10"
                            IsSnapToTickEnabled="False"
                            ValueChanged="LyricOffsetSlider_ValueChanged" />
                    <TextBlock x:Name="LyricOffsetHintText"
                               Margin="0,4,0,0"
                               Foreground="#8FAEBBC1"
                               FontSize="11"
                               Text="Higher values show lines earlier." />

                    <TextBlock x:Name="MainFontLabel" Margin="0,12,0,0" Text="Main text size" />
                    <Slider x:Name="MainFontSlider"
                            Minimum="20"
                            Maximum="56"
                            ValueChanged="MainFontSlider_ValueChanged" />

                    <TextBlock x:Name="OriginalFontLabel" Margin="0,12,0,0" Text="Original text size" />
                    <Slider x:Name="OriginalFontSlider"
                            Minimum="12"
                            Maximum="32"
                            ValueChanged="OriginalFontSlider_ValueChanged" />

                    <TextBlock x:Name="BackgroundOpacityLabel" Margin="0,12,0,0" Text="Background opacity" />
                    <Slider x:Name="BackgroundOpacitySlider"
                            Minimum="0"
                            Maximum="100"
                            ValueChanged="BackgroundOpacitySlider_ValueChanged" />

                    <TextBlock x:Name="LyricPositionXLabel" Margin="0,12,0,0" Text="Lyric X" />
                    <Slider x:Name="LyricPositionXSlider"
                            Minimum="-360"
                            Maximum="360"
                            TickFrequency="1"
                            ValueChanged="LyricPositionXSlider_ValueChanged" />

                    <TextBlock x:Name="LyricPositionYLabel" Margin="0,12,0,0" Text="Lyric Y" />
                    <Slider x:Name="LyricPositionYSlider"
                            Minimum="-180"
                            Maximum="180"
                            TickFrequency="1"
                            ValueChanged="LyricPositionYSlider_ValueChanged" />

                    <TextBlock x:Name="IslandWidthLabel" Margin="0,12,0,0" Text="Island width" />
                    <Slider x:Name="IslandWidthSlider"
                            Minimum="360"
                            Maximum="1200"
                            TickFrequency="10"
                            ValueChanged="IslandWidthSlider_ValueChanged" />

                    <TextBlock x:Name="IslandHeightLabel" Margin="0,12,0,0" Text="Island height" />
                    <Slider x:Name="IslandHeightSlider"
                            Minimum="64"
                            Maximum="180"
                            TickFrequency="2"
                            ValueChanged="IslandHeightSlider_ValueChanged" />

                    <TextBlock x:Name="IslandTopOffsetLabel" Margin="0,12,0,0" Text="Island top offset" />
                    <Slider x:Name="IslandTopOffsetSlider"
                            Minimum="0"
                            Maximum="120"
                            TickFrequency="1"
                            ValueChanged="IslandTopOffsetSlider_ValueChanged" />

                    <TextBlock x:Name="MainColorLabel" Margin="0,14,0,6" Text="Main color" />
                    <StackPanel Orientation="Horizontal">
                        <Button Tag="#FFFFFFFF" Background="#FFFFFFFF" Click="MainColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#FF5DFFE6" Background="#FF5DFFE6" Click="MainColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#FFFFE082" Background="#FFFFE082" Click="MainColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#FFFF8FB3" Background="#FFFF8FB3" Click="MainColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#FFB8FF8B" Background="#FFB8FF8B" Click="MainColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button x:Name="CustomMainColorButton" Width="68" Height="24" Click="CustomMainColorButton_Click" Content="Custom" Style="{StaticResource ToolButtonStyle}" />
                    </StackPanel>

                    <TextBlock x:Name="OriginalColorLabel" Margin="0,14,0,6" Text="Original color" />
                    <StackPanel Orientation="Horizontal">
                        <Button Tag="#D5FFFFFF" Background="#D5FFFFFF" Click="OriginalColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#FFB6C7D8" Background="#FFB6C7D8" Click="OriginalColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#FFFFE082" Background="#FFFFE082" Click="OriginalColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#FFB8FF8B" Background="#FFB8FF8B" Click="OriginalColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button x:Name="CustomOriginalColorButton" Width="68" Height="24" Click="CustomOriginalColorButton_Click" Content="Custom" Style="{StaticResource ToolButtonStyle}" />
                    </StackPanel>

                    <TextBlock x:Name="BackgroundColorLabel" Margin="0,14,0,6" Text="Background color" />
                    <StackPanel Orientation="Horizontal">
                        <Button Tag="#181B22" Background="#FF181B22" Click="BackgroundColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#F7F7F2" Background="#FFF7F7F2" Click="BackgroundColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#101418" Background="#FF101418" Click="BackgroundColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#1F2732" Background="#FF1F2732" Click="BackgroundColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#FFF4E8" Background="#FFFFF4E8" Click="BackgroundColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button x:Name="CustomBackgroundColorButton" Width="68" Height="24" Click="CustomBackgroundColorButton_Click" Content="Custom" Style="{StaticResource ToolButtonStyle}" />
                    </StackPanel>

                    <TextBlock x:Name="AccentColorLabel" Margin="0,14,0,6" Text="Accent color" />
                    <StackPanel Orientation="Horizontal">
                        <Button Tag="#5DFFE6" Background="#FF5DFFE6" Click="AccentColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#FF4D6D" Background="#FFFF4D6D" Click="AccentColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#8BC7FF" Background="#FF8BC7FF" Click="AccentColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button Tag="#FFD166" Background="#FFFFD166" Click="AccentColorButton_Click" Style="{StaticResource SwatchStyle}" />
                        <Button x:Name="CustomAccentColorButton" Width="68" Height="24" Click="CustomAccentColorButton_Click" Content="Custom" Style="{StaticResource ToolButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
